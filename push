if [ -n "$1" ]; then
    COMMIT_MESSAGE="$1"
else
    echo Commit message?
    read COMMIT_MESSAGE
fi

echo '\n# Compressing new PNG screenshots (lossless)...'
if ! ./tools/compress-screenshots; then
    echo '\n!!! PNG compression failed. Nothing was pushed. !!!'
    exit 1
fi

echo '\n# Updating cache...'
if ! ./tools/update-cache; then
    echo '\n!!! Cache update failed. Nothing was pushed. !!!'
    exit 1
fi
echo '\n# Cache updated!'

echo '\n# Committing site code changes...'
git add .
git commit -m "$COMMIT_MESSAGE"

echo '\n# Pushing site code to GitHub repository...'
git remote set-url origin git@github.com:leomancini/projects-site-generator.git # Ensure origin always points to GitHub
git push origin # Push site/ viewer code to GitHub

echo '\n# Pushing site code to leomancini.net...'
git push leo@root.noshado.ws:/home/leo/domains/leomancini.net/site.git # Push site/ viewer code to leomancini.net

echo '\n# Auto-tagging projects...'
node tools/auto-tag.js

echo '\n# Syncing projects to leomancini.net...'
./tools/sync-projects push # Mirror projects/ content to leomancini.net (rsync, no git)

echo '\n### Done! ###'
