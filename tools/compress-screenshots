#!/bin/sh
# Losslessly compresses PNG screenshots that are new or changed in the projects repo.
# Runs oxipng on staged, unstaged, and untracked *.png files under */screenshots/,
# so already-committed images are never re-processed. Pixels are never altered.
set -e

cd "$(dirname "$0")/../projects"

if ! command -v oxipng >/dev/null 2>&1; then
    echo "oxipng is not installed or not on PATH (try: brew install oxipng); skipping PNG compression" >&2
    exit 0
fi

FILES=$( {
    git diff --cached --name-only --diff-filter=AM -- '*/screenshots/*.png'
    git ls-files -m -o --exclude-standard -- '*/screenshots/*.png'
} | sort -u )

if [ -z "$FILES" ]; then
    echo "No new or changed PNG screenshots to compress."
    exit 0
fi

echo "$FILES" | while IFS= read -r f; do
    [ -f "$f" ] || continue # skip files deleted from the working tree
    oxipng -o max --strip safe "$f"
done
