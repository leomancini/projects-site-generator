#!/bin/sh
# Syncs projects/ with leomancini.net over rsync. The projects folder is not a
# git repo: media is too heavy for git, so the server copy is a plain mirror.
#
#   tools/sync-projects push [--dry-run]   local -> server, deletes files removed locally
#   tools/sync-projects pull [--dry-run]   server -> local, never deletes or overwrites newer local files
set -e

cd "$(dirname "$0")/.."

REMOTE="leo@root.noshado.ws:/home/leo/domains/leomancini.net/html/projects/"
LOCAL="projects/"

DIRECTION="$1"
[ $# -gt 0 ] && shift

# Times are preserved so unchanged files are skipped; owner, group and
# permissions are left to the server (files there belong to the web group).
set -- -rltz --omit-dir-times \
    --exclude=.DS_Store --exclude=.git --exclude=.claude "$@"

case "$DIRECTION" in
    push) rsync "$@" --delete --itemize-changes "$LOCAL" "$REMOTE" ;;
    pull) rsync "$@" --update --itemize-changes "$REMOTE" "$LOCAL" ;;
    *) echo "Usage: $0 push|pull [--dry-run]" >&2; exit 1 ;;
esac
